<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="robot_base_length" value="0.1" />
    <xacro:property name="robot_base_width" value="0.1" />
    <xacro:property name="robot_base_height" value="0.02" />

    <xacro:property name="base_length" value="0.6" />
    <xacro:property name="base_width" value="0.4" />
    <xacro:property name="base_height" value="0.2" />


    <link name="arm_base">
        
        <visual>
            <geometry>
                <box size="${robot_base_length} ${robot_base_width} ${robot_base_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="orange" />
        </visual>

        <collision>
            <geometry>
                <box size="${robot_base_length} ${robot_base_width} ${robot_base_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <xacro:box_inertia m="0.1" 
                           x= "${robot_base_length}" 
                           y="${robot_base_width}" 
                           z="${robot_base_height}"
                           o_xyz="0 0 0" 
                           o_rpy="0 0 0"/>
    </link>


    <joint name="base_arm_base" type="fixed">
        <parent link="base_link" />
        <child link="arm_base" />
        <origin
            xyz="${base_length/4} 0 ${base_height + robot_base_height / 2}"
            rpy="0 0 0" />
    </joint>



</robot>