<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="robot_base_length" value="0.1" />
    <xacro:property name="robot_base_width" value="0.1" />
    <xacro:property name="robot_base_height" value="0.02" />

    <xacro:property name="base_length" value="0.6" />
    <xacro:property name="base_width" value="0.4" />
    <xacro:property name="base_height" value="0.2" />

    <xacro:property name="arm_radius" value="0.02" />
    <xacro:property name="arm_length" value="0.3" />



    <link name="arm_base">
        
        <visual>
            <geometry>
                <box size="${robot_base_length} ${robot_base_width} ${robot_base_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="orange" />
        </visual>

        <collision>
            <geometry>
                <box size="${robot_base_length} ${robot_base_width} ${robot_base_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <xacro:box_inertia m="0.1" 
                           x= "${robot_base_length}" 
                           y="${robot_base_width}" 
                           z="${robot_base_height}"
                           o_xyz="0 0 0" 
                           o_rpy="0 0 0"/>
    </link>



    <xacro:macro name="arm" params="prefix">
        <link name="${prefix}_link">
            <visual>
                <geometry>
                    <cylinder radius="${arm_radius}" length="${arm_length}" />
                </geometry>
                <origin xyz="0 0 ${arm_length / 2.0 }" rpy="0 0 0" />
                <material name="orange" />
            </visual>   
            <collision>
                <geometry>
                    <origin xyz="0 0 ${arm_length / 2.0 }" rpy="0 0 0" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
            </collision>
            <xacro:cylinder_inertia m="1.0" r="${arm_radius}" l="${arm_length}"
                           o_xyz="0 0 ${arm_length / 2.0 }" o_rpy="0 0 0"/>
        </link>
    </xacro:macro>

    <xacro:arm prefix="forearm" />
    <xacro:arm prefix="hand" />

    


    <joint name="base_arm_base" type="fixed">
        <parent link="base_link" />
        <child link="arm_base" />
        <origin
            xyz="${base_length/4} 0 ${base_height + robot_base_height / 2}"
            rpy="0 0 0" />
    </joint>


    <joint name="arm_base_forearm" type="revolute">
        <parent link="arm_base" />
        <child link="forearm_link" />
        <origin
            xyz="0 0 ${robot_base_height}"
            rpy="0 0 0" />
        <axis xyz="0 1 0"/>
        <limit lower="0" upper="1.57" effort="100" velocity="100"/> 
        <dynamics friction="0.3" damping="0.3" />
    </joint>

    <joint name="forearm_hand" type="revolute">
        <parent link="forearm_link" />
        <child link="hand_link" />
        <origin
            xyz="0 0 ${arm_length}"
            rpy="0 0 0" />
        <axis xyz="0 1 0"/>
        <limit lower="0" upper="1.57" effort="100" velocity="100"/> 
        <dynamics friction="0.3" damping="0.3" />
    </joint>

</robot>